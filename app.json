{
  "expo": {
    "name": "Library",
    "slug": "library-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/library-logo.png",
    "scheme": "libraryapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow Library to sync offline book and borrowing changes with other devices on your local Wi-Fi network.",
        "NSBonjourServices": [
          "_r58inventory._tcp"
        ]
      }
    },
    "android": {
      "package": "com.ssda.libraryapp",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFF7FA"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/library-logo.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7FA"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "948aef71-da40-4f18-ac27-1610f6db0623"
      }
    }
  }
}
